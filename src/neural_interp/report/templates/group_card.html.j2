{% from "macros.html.j2" import chip, composition_bar, strips %}
<section class="card" style="--c:{{ card.clusters[0].color }}">
  <header style="background:linear-gradient(90deg,{{ card.clusters|map(attribute='color')|join(', ') }})">
    <h3>{{ card.name }}</h3>
    <span>n={{ card.size|fmt(',') }}</span>
    {{ composition_bar(card.composition) }}
    <a class="open" href="{{ card.href }}">open page &rarr;</a>
  </header>
  <div class="body">
    <div class="meta">
      <span>clusters {% for cluster in card.clusters %}{{ chip(cluster) }}{% endfor %}</span>
    </div>
    {{ strips("Hits ordered from the most to the least probable in the leading cluster", card.hits) }}
  </div>
</section>
