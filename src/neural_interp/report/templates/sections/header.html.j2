<h1>{{ unit }}</h1>
<div class="stats">
  {% for value, name in stats %}
  <div class="stat"><b>{{ value }}</b><span>{{ name }}</span></div>
  {% endfor %}
</div>
<details class="guide">
  <summary>How to read this report</summary>
  <dl>
    {% for item in guide %}
    <dt>{{ item.term }}{% if item.step %} <span class="step">step {{ item.step }}: {{ item.title }}</span>{% endif %}</dt>
    <dd>{{ item.text }}</dd>
    {% endfor %}
  </dl>
</details>
